# Dependencies
node_modules/

# Build output
dist/

# Generated types, from `astro sync`
.astro/

# Caches left by the tooling that preceded this build, and by Quarto
.docusaurus/
.quarto/
**/*.quarto_ipynb

# Environment files. The negation keeps a future `.env.example` tracked, so the
# shape of the configuration stays documented.
.env
.env.*
!.env.example

# Logs
*.log

# Editors and operating systems
.DS_Store
.idea/
.vscode/

# Local Wrangler state, written by `wrangler pages deploy`
.wrangler/
