---
import Section from './Section.astro';
import { principles } from '../consts';
---

<Section id="principles" title="Design principles">
  <p>
    The model is designed around five properties. Each of them follows from the structure rather
    than from a feature added later, and each is a claim the implementation is expected to bear
    out.
  </p>

  <dl class="defs">
    {
      principles.map((principle) => (
        <>
          <dt>{principle.name}</dt>
          <dd>{principle.body}</dd>
        </>
      ))
    }
  </dl>
</Section>
