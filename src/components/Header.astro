---
import { elsewhere, site } from '../consts';

const items = [
  ...elsewhere,
  { label: 'Support', href: site.sponsors },
  { label: 'Contact', href: `mailto:${site.contact}` },
  { label: 'PGP key', href: site.contactKey },
];
---

<header>
  <nav class="nav column" aria-label="Elsewhere">
    {
      items.map((item, index) => (
        <>
          {index > 0 && (
            <span class="nav__sep" aria-hidden="true">
              ·
            </span>
          )}
          <span>
            <a href={item.href}>{item.label}</a>
          </span>
        </>
      ))
    }
  </nav>
</header>

<style>
  /* The navigation line sits above the title, centred, and wraps when it has to. */
  .nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-bottom: 22px;
    font-size: 0.9rem;
  }

  .nav__sep {
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .nav {
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }

    .nav__sep {
      display: none;
    }
  }
</style>
