---
// The scene the page opens on, drawn from the model itself. Plotly's gl3d bundle
// is fetched only when the browser has WebGL and only when the scene is about to
// be seen, because it is by far the largest asset on the site.
//
// In backdrop mode the scene sits behind the opening block, bleeding past it on
// every side, and it is desaturated so the page stays in one ink.

interface Props {
  backdrop?: boolean;
}

const { backdrop = false } = Astro.props;
---

<div class:list={['monument', backdrop && 'monument--backdrop']} data-monument>
  <div
    class="monument__stage"
    data-stage
    role="img"
    aria-label="The primitives of the model in one scene: Segments on the coordinate space, a Scheme binding them, a Field raising a constraint potential, Observations producing projections, and Data as the result they record."
  >
    <noscript>
      <p class="monument__note">
        The scene is drawn in the browser and needs WebGL. The primitives it shows are defined in
        the Model section.
      </p>
    </noscript>
  </div>
</div>

<style>
  .monument {
    margin: 0;
  }

  .monument__stage {
    position: relative;
    width: 100%;
    height: clamp(420px, 55vh, 640px);
  }

  /* The scene stands behind the opening block, full and slightly off to the
     right, running past the viewport rather than stopping inside it. It sits
     behind everything on the page, including the sections that follow the
     opening block, and it fades out towards the left and downwards, which keeps
     the reading column clear.

     The box is sized off the viewport and keeps the aspect of the drawing, so
     the drawing runs past the viewport on both sides rather than sitting inside
     it. The width term sets how far past: it is what makes the desktop drawing
     as generous as the one on a phone, where the height term takes over and the
     drawing runs well past both edges. The drawing turns, and a square
     coordinate space projects 41 percent wider on the diagonal than on the axis,
     so the camera stands back far enough that the drawing never touches the box
     at any azimuth, and only the mask and the viewport cut it. */
  .monument--backdrop {
    --scene-width: max(220vw, 126vh);
    position: absolute;
    top: -26vh;
    left: calc(50% - var(--scene-width) * 0.46);
    width: var(--scene-width);
    height: calc(var(--scene-width) * 0.539);
    z-index: -1;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(104% 92% at 68% 48%, #000 0%, #000 34%, rgba(0, 0, 0, 0) 80%);
    mask-image: radial-gradient(104% 92% at 68% 48%, #000 0%, #000 34%, rgba(0, 0, 0, 0) 80%);
  }

  .monument--backdrop .monument__stage {
    height: 100%;
  }

  /* The stage is replaced by this note when the browser cannot draw the scene,
     so the element is created by the script and carries no scope attribute. */
  :global(.monument__note) {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0 24px;
    text-align: center;
    font-size: 14px;
    color: var(--fg-3);
  }
</style>

<script>
  import { MONUMENT_SCENE, startSpectrumDrift } from '../lib/monument';

  const UNAVAILABLE =
    'The interactive scene needs WebGL, which this browser did not provide. The same primitives are described in the Model section.';

  const figure = document.querySelector('[data-monument]');
  const stage = figure && figure.querySelector('[data-stage]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const wide = 720;

  const backdrop = !!(figure && figure.classList.contains('monument--backdrop'));

  // Plotly's gl3d bundle ships no types, so the graph handle and the library are
  // annotated with the shapes this file actually uses.
  let plot: any = null;
  let plotly: any = null;
  let orbit: any = null;

  function note(text: string) {
    if (!stage) {
      return;
    }
    const paragraph = document.createElement('p');
    paragraph.className = 'monument__note';
    paragraph.textContent = text;
    stage.replaceChildren(paragraph);
  }

  function webglAvailable() {
    try {
      const canvas = document.createElement('canvas');
      const context = (canvas.getContext('webgl') ||
        canvas.getContext('experimental-webgl')) as WebGLRenderingContext | null;
      if (context) {
        const lose = context.getExtension('WEBGL_lose_context');
        if (lose) {
          lose.loseContext();
        }
      }
      return !!context;
    } catch {
      return false;
    }
  }

  // The backdrop carries the same drawing as the figure, with the axis titles and
  // the legend left out so nothing competes with the reading column.
  function scene() {
    const base = MONUMENT_SCENE.layout.scene;
    if (!backdrop) {
      return { ...base, dragmode: 'turntable' };
    }
    const untitled = (axis: Record<string, unknown>) => ({ ...axis, title: { text: '' } });
    return {
      ...base,
      dragmode: 'turntable',
      xaxis: untitled(base.xaxis),
      yaxis: untitled(base.yaxis),
      zaxis: untitled(base.zaxis),
    };
  }

  // The orbit moves the camera eye only, so the centre stays where it is. The
  // circle is derived from the camera actually applied to the scene, so the drift
  // continues from the view on screen rather than snapping to one from the layout.
  // One turn takes this long. The camera is moved by the clock rather than by a
  // fixed step per tick, so the turn keeps its speed however fast frames arrive,
  // and the next move is scheduled only once the last one has been drawn, so a
  // slow frame stretches the interval instead of stacking up behind it.
  const TURN_SECONDS = backdrop ? 240 : 120;
  const TURN_RATE = (2 * Math.PI) / TURN_SECONDS;

  function startOrbit() {
    stopOrbit();
    const applied =
      (plot._fullLayout && plot._fullLayout.scene && plot._fullLayout.scene.camera) ||
      MONUMENT_SCENE.layout.scene.camera;
    const { x, y, z } = applied.eye;
    const radius = Math.hypot(x, y);
    let azimuth = Math.atan2(y, x);
    let previous = performance.now();
    const state: any = { running: true, frame: 0 };
    orbit = state;

    const step = async (now: number) => {
      if (!state.running || !plot._fullLayout) {
        return;
      }
      azimuth += TURN_RATE * ((now - previous) / 1000);
      previous = now;
      await plotly.relayout(plot, {
        'scene.camera.eye': {
          x: radius * Math.cos(azimuth),
          y: radius * Math.sin(azimuth),
          z,
        },
      });
      if (state.running) {
        state.frame = window.requestAnimationFrame(step);
      }
    };

    state.frame = window.requestAnimationFrame(step);
  }

  function stopOrbit() {
    if (orbit) {
      orbit.running = false;
      window.cancelAnimationFrame(orbit.frame);
      orbit = null;
    }
  }

  async function build() {
    if (!stage || plot) {
      return;
    }
    if (!webglAvailable()) {
      note(UNAVAILABLE);
      return;
    }
    const module = await import('plotly.js/dist/plotly-gl3d.min.js');
    plotly = module.default || module;
    plot = await plotly.newPlot(
      stage,
      MONUMENT_SCENE.data,
      {
        ...MONUMENT_SCENE.layout,
        uirevision: 'ssccs-monument',
        showlegend: !backdrop && window.innerWidth > wide,
        scene: scene(),
      },
      { displayModeBar: false, responsive: true },
    );
    if (!backdrop) {
      stage.addEventListener('pointerdown', stopOrbit);
    }
    if (!reduced.matches) {
      startOrbit();
      startSpectrumDrift(plot, plotly);
    }
  }

  if (figure && stage) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) {
            continue;
          }
          observer.disconnect();
          build().catch(() => note(UNAVAILABLE));
        }
      },
      { rootMargin: '300px' },
    );
    observer.observe(figure);

    if (!backdrop) {
      window.addEventListener('resize', () => {
        if (plot) {
          plotly.relayout(plot, { showlegend: window.innerWidth > wide });
        }
      });
    }

    reduced.addEventListener('change', () => {
      if (reduced.matches) {
        stopOrbit();
      } else if (plot) {
        startOrbit();
      }
    });
  }
</script>
