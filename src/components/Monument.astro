---
// The scene the page opens on, drawn from the model itself. Plotly's gl3d bundle
// is fetched only when the browser has WebGL and only when the scene is about to
// be seen, because it is by far the largest asset on the site.
//
// In backdrop mode the scene sits behind the opening block, bleeding past it on
// every side, and it is desaturated so the page stays in one ink.

interface Props {
  backdrop?: boolean;
}

const { backdrop = false } = Astro.props;
---

<div class:list={['monument', backdrop && 'monument--backdrop']} data-monument>
  <div
    class="monument__stage"
    data-stage
    role="img"
    aria-label="The primitives of the model in one scene: Segments on the coordinate space, a Scheme binding them, a Field raising a constraint potential, Observations producing projections, and Data as the result they record."
  >
    <noscript>
      <p class="monument__note">
        The scene is drawn in the browser and needs WebGL. The primitives it shows are defined in
        the Model section.
      </p>
    </noscript>
  </div>
</div>

<style>
  .monument {
    margin: 0;
  }

  .monument__stage {
    position: relative;
    width: 100%;
    height: clamp(420px, 55vh, 640px);
  }

  /* The scene stands behind the opening block, full and slightly off to the
     right, running past the viewport rather than stopping inside it. It sits
     behind everything on the page, including the sections that follow the
     opening block, and it fades out towards the left and downwards, which keeps
     the reading column clear.

     The box is sized off the viewport and keeps the aspect of the drawing, so
     the drawing runs past the viewport on both sides rather than sitting inside
     it. The width term sets how far past: it is what makes the desktop drawing
     as generous as the one on a phone, where the height term takes over and the
     drawing runs well past both edges. The drawing turns, and a square
     coordinate space projects 41 percent wider on the diagonal than on the axis,
     so the camera stands back far enough that the drawing never touches the box
     at any azimuth, and only the mask and the viewport cut it. */
  .monument--backdrop {
    --scene-width: max(220vw, 126vh);
    position: absolute;
    top: -26vh;
    left: calc(50% - var(--scene-width) * 0.46);
    width: var(--scene-width);
    height: calc(var(--scene-width) * 0.539);
    z-index: -1;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(104% 92% at 68% 48%, #000 0%, #000 34%, rgba(0, 0, 0, 0) 80%);
    mask-image: radial-gradient(104% 92% at 68% 48%, #000 0%, #000 34%, rgba(0, 0, 0, 0) 80%);
    animation: scene-hue 115s ease-in-out infinite;
  }

  /* The colour scheme of the scene turns over as a whole. The turn is made over the
     canvas rather than inside the drawing, so it costs the compositor one filter pass
     and never touches the scene graph: the colour moves while the camera is moving,
     and neither can stall the other. Every hue turns together, so the sheet's spectrum
     and the ink of the lines keep the relation the drawing is built on at every phase.

     The turn is one swing out and back: the hue stands at zero a quarter of the way in
     from either end, and reaches the near end of the swing a quarter of the way through
     and the far end at three quarters. The phase a page opens on is taken from the
     clock rather than from zero, so two visits do not begin on the same colour. */
  @keyframes scene-hue {
    0%,
    50%,
    100% {
      filter: none;
    }
    25% {
      filter: hue-rotate(48deg);
    }
    75% {
      filter: hue-rotate(-48deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .monument--backdrop {
      animation: none;
    }
  }

  .monument--backdrop .monument__stage {
    height: 100%;
  }

  /* The stage is replaced by this note when the browser cannot draw the scene,
     so the element is created by the script and carries no scope attribute. */
  :global(.monument__note) {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0 24px;
    text-align: center;
    font-size: 14px;
    color: var(--fg-3);
  }
</style>

<script>
  import { MONUMENT_SCENE } from '../lib/monument';

  const UNAVAILABLE =
    'The interactive scene needs WebGL, which this browser did not provide. The same primitives are described in the Model section.';

  const figure = document.querySelector<HTMLElement>('[data-monument]');
  const stage = figure && figure.querySelector('[data-stage]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const wide = 720;

  const backdrop = !!(figure && figure.classList.contains('monument--backdrop'));

  // The colour turn opens on the phase the clock is at rather than on zero, so two
  // visits to the page do not begin on the same colour. The period is the one the
  // stylesheet sets, read back here so it is stated in one place.
  if (figure) {
    const period = parseFloat(getComputedStyle(figure).animationDuration) || 0;
    if (period > 0) {
      figure.style.animationDelay = `-${((Date.now() / 1000) % period).toFixed(3)}s`;
    }
  }

  // Plotly's gl3d bundle ships no types, so the graph handle and the library are
  // annotated with the shapes this file actually uses.
  let plot: any = null;
  let plotly: any = null;
  let orbit: any = null;

  function note(text: string) {
    if (!stage) {
      return;
    }
    const paragraph = document.createElement('p');
    paragraph.className = 'monument__note';
    paragraph.textContent = text;
    stage.replaceChildren(paragraph);
  }

  function webglAvailable() {
    try {
      const canvas = document.createElement('canvas');
      const context = (canvas.getContext('webgl') ||
        canvas.getContext('experimental-webgl')) as WebGLRenderingContext | null;
      if (context) {
        const lose = context.getExtension('WEBGL_lose_context');
        if (lose) {
          lose.loseContext();
        }
      }
      return !!context;
    } catch {
      return false;
    }
  }

  // The backdrop carries the same drawing as the figure, with the axis titles and
  // the legend left out so nothing competes with the reading column.
  function scene() {
    const base = MONUMENT_SCENE.layout.scene;
    if (!backdrop) {
      return { ...base, dragmode: 'turntable' };
    }
    const untitled = (axis: Record<string, unknown>) => ({ ...axis, title: { text: '' } });
    return {
      ...base,
      dragmode: 'turntable',
      xaxis: untitled(base.xaxis),
      yaxis: untitled(base.yaxis),
      zaxis: untitled(base.zaxis),
    };
  }

  // The orbit moves the camera eye only, so the centre stays where it is. The
  // circle is derived from the camera actually applied to the scene, so the orbit
  // continues from the view on screen rather than snapping to one from the layout.
  // One turn takes this long. The camera is moved by the clock rather than by a
  // fixed step per tick, so the turn keeps its speed however fast frames arrive,
  // and the next move is scheduled only once the last one has been drawn, so a
  // slow frame stretches the interval instead of stacking up behind it.
  const TURN_SECONDS = backdrop ? 240 : 120;
  const TURN_RATE = (2 * Math.PI) / TURN_SECONDS;

  // The view also follows the pointer. The pointer sets where the camera is asked to
  // be, and a critically damped spring carries the camera there: it leaves rest,
  // gathers speed and settles, so sweeping the cursor turns the scene under its own
  // weight instead of dragging it. The period is the spring's own, in seconds. It is
  // set far above the time a pointer takes to cross the page, so the scene answers a
  // movement over many seconds and keeps moving long after the pointer has stopped.
  const FOLLOW = { azimuth: 0.5, lift: 0.22, period: 15 };
  const followed = { azimuth: 0, lift: 0 };

  function followPointer(event: PointerEvent) {
    if (event.pointerType && event.pointerType !== 'mouse') {
      return;
    }
    // Held to the window: a pointer can be reported outside it, and the camera is
    // asked for a share of the window rather than for a position.
    const across = Math.max(-1, Math.min(1, (event.clientX / window.innerWidth) * 2 - 1));
    const down = Math.max(-1, Math.min(1, (event.clientY / window.innerHeight) * 2 - 1));
    followed.azimuth = across * FOLLOW.azimuth;
    followed.lift = down * FOLLOW.lift;
  }

  // The pointer asks; the camera arrives on its own time. The backdrop follows the
  // pointer because the page keeps it: the scene there is behind the reading column and
  // takes no drag. A figure keeps the drag it draws on the canvas instead.
  if (backdrop) {
    window.addEventListener('pointermove', followPointer);
    window.addEventListener('pointerleave', () => {
      followed.azimuth = 0;
      followed.lift = 0;
    });
  }

  // One step of a critically damped spring, in seconds.
  function spring(value: number, velocity: number, target: number, dt: number) {
    const omega = (2 * Math.PI) / FOLLOW.period;
    const acceleration = omega * omega * (target - value) - 2 * omega * velocity;
    const next = velocity + acceleration * dt;
    return { value: value + next * dt, velocity: next };
  }

  function startOrbit() {
    stopOrbit();
    const applied =
      (plot._fullLayout && plot._fullLayout.scene && plot._fullLayout.scene.camera) ||
      MONUMENT_SCENE.layout.scene.camera;
    const { x, y, z } = applied.eye;
    const radius = Math.hypot(x, y);
    let azimuth = Math.atan2(y, x); // where the view is asked to be
    let turned = azimuth; // where the camera is
    let turnSpeed = 0;
    let height = z;
    let heightSpeed = 0;
    let previous = performance.now();
    const state: any = { running: true, frame: 0 };
    orbit = state;

    const step = async (now: number) => {
      if (!state.running || !plot._fullLayout) {
        return;
      }
      const dt = Math.min(0.25, (now - previous) / 1000);
      previous = now;
      azimuth += TURN_RATE * dt;
      const angle = spring(turned, turnSpeed, azimuth + followed.azimuth, dt);
      turned = angle.value;
      turnSpeed = angle.velocity;
      const lifted = spring(height, heightSpeed, z + followed.lift, dt);
      height = lifted.value;
      heightSpeed = lifted.velocity;
      await plotly.relayout(plot, {
        'scene.camera.eye': {
          x: radius * Math.cos(turned),
          y: radius * Math.sin(turned),
          z: height,
        },
      });
      if (state.running) {
        state.frame = window.requestAnimationFrame(step);
      }
    };

    state.frame = window.requestAnimationFrame(step);
  }

  function stopOrbit() {
    if (orbit) {
      orbit.running = false;
      window.cancelAnimationFrame(orbit.frame);
      orbit = null;
    }
  }

  async function build() {
    if (!stage || plot) {
      return;
    }
    if (!webglAvailable()) {
      note(UNAVAILABLE);
      return;
    }
    const module = await import('plotly.js/dist/plotly-gl3d.min.js');
    plotly = module.default || module;
    plot = await plotly.newPlot(
      stage,
      MONUMENT_SCENE.data,
      {
        ...MONUMENT_SCENE.layout,
        uirevision: 'ssccs-monument',
        showlegend: !backdrop && window.innerWidth > wide,
        scene: scene(),
      },
      { displayModeBar: false, responsive: true },
    );
    if (!backdrop) {
      stage.addEventListener('pointerdown', stopOrbit);
    }
    if (!reduced.matches) {
      startOrbit();
    }
  }

  if (figure && stage) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) {
            continue;
          }
          observer.disconnect();
          build().catch(() => note(UNAVAILABLE));
        }
      },
      { rootMargin: '300px' },
    );
    observer.observe(figure);

    if (!backdrop) {
      window.addEventListener('resize', () => {
        if (plot) {
          plotly.relayout(plot, { showlegend: window.innerWidth > wide });
        }
      });
    }

    reduced.addEventListener('change', () => {
      if (reduced.matches) {
        stopOrbit();
      } else if (plot) {
        startOrbit();
      }
    });
  }
</script>
