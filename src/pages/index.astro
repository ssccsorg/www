---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Model from '../components/Model.astro';
import Architecture from '../components/Architecture.astro';
import Principles from '../components/Principles.astro';
import Domains from '../components/Domains.astro';
import CurrentWork from '../components/CurrentWork.astro';
import Projects from '../components/Projects.astro';
import Engagements from '../components/Engagements.astro';
import Sponsorship from '../components/Sponsorship.astro';
import { site } from '../consts';
---

<Base title={`${site.fullName} · ${site.name}`} description={site.description}>
  <Intro />
  <Model />
  <Architecture />
  <Principles />
  <Domains />
  <CurrentWork />
  <Projects />
  <Engagements />
  <Sponsorship />
</Base>
